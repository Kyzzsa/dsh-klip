{
  "name": "dsh-klip",
  "description": "DeepSeek Harness plugin: KInterval interval language and the /klip command that splits a conversation into new sessions.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/build.mjs --check",
    "test": "node --experimental-strip-types --test test/k-interval.test.ts test/re-index.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "dlv": "^1.1.3",
    "dset": "^3.1.4"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "@types/dlv": "^1.1.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
